#!/usr/bin/env python3
"""slice-submit: hand one slice of the epic to the supervisor.

    slice-submit --slice <n> --claim <file> --subject "<scope>: <what changed>" \\
                 [--builds-on <m>]

"Take my workspace as it is now." The command writes a request under
/fsm/out/submit/ and waits until the supervisor has copied /workspace. Do not
change /workspace, and let every helper finish, before this command returns.

  --slice      the slice number: 1, 2, 3, ... The same number again is a new
               round of that slice.
  --claim      a file that says what this slice delivers (at most 64 KiB)
  --subject    the commit subject, without an issue reference
  --builds-on  an earlier slice this one needs, while that slice is not merged

The command reads from git which origin/develop commit /workspace is built on
(`git merge-base HEAD origin/develop`) and sends it with the request. To bring
in newer develop commits, merge origin/develop and commit the merge before
you submit. The command sends nothing (exit 2) when a merge, cherry-pick,
revert or rebase is not finished, and when the files hold what a newer
develop commit made while git has no merge of it (a squash merge, copied
files, a slice of yours that has merged). `--base` is still accepted and is
not used.

Exit code: 0 the supervisor took the snapshot; 1 it refused the request (the
reason is printed); 2 wrong arguments; 3 no answer inside the time limit.

The snapshot is only the first step. The result of the validator comes later,
in /fsm/context/slices/<n>/ and as an event at the start of a turn.
"""
import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time
import uuid

OUT = os.environ.get("CFGMS_FSM_OUT") or "/fsm/out"
CONTEXT = os.environ.get("CFGMS_FSM_CONTEXT") or "/fsm/context"
WORKSPACE = os.environ.get("CFGMS_FSM_WORKSPACE") or "/workspace"
DEVELOP_REF = "refs/remotes/origin/develop"
CLAIM_CAP = 64 * 1024
SUBJECT_MAX_CHARS = 150
DEFAULT_WAIT_SECS = 900
WITHDRAW_GRACE_SECS = 10


def fail(code, text):
    print(f"slice-submit: {text}", file=sys.stderr)
    sys.exit(code)


def git_raw(*args, stdin=None):
    """(exit code, stdout bytes) of git in the workspace."""
    try:
        proc = subprocess.run(["git", "-C", WORKSPACE, *args], capture_output=True, timeout=300,
                              input=stdin)
    except (OSError, subprocess.TimeoutExpired) as exc:
        fail(2, f"cannot run git in {WORKSPACE}: {exc}. No request was sent.")
    return proc.returncode, proc.stdout


def git(*args):
    """(exit code, stdout) of git in the workspace."""
    code, out = git_raw(*args)
    return code, out.decode("utf-8", "replace").strip()


ABSENT = "0" * 40


def develop_in_files(base):
    """Paths where the work tree holds what a develop commit after `base`
    made and `base` did not have.

    The supervisor measures the slice against `base`. Such a path would be
    read as a change of the slice: a develop change that develop took back
    would be published again, a develop change to a protected path would be
    refused as the slice's, a conflict the owner repaired would come again.
    A real merge of origin/develop moves the base and ends this."""
    code, out = git_raw("log", "--first-parent", "-m", "--format=", "--raw", "--no-abbrev",
                        "--no-renames", "-z", f"{base}..{DEVELOP_REF}")
    if code != 0:
        fail(2, f"cannot read the develop commits after {base[:12]}. No request was sent.")
    made = {}                                   # path -> blobs develop commits gave it
    parts = out.split(b"\0")
    for i, part in enumerate(parts[:-1]):
        meta = part.lstrip(b"\n")
        if not meta.startswith(b":"):
            continue
        fields = meta.split()
        if len(fields) < 5 or fields[1] == b"160000" or fields[0] == b":160000":
            continue                            # a submodule pointer is not a file
        made.setdefault(parts[i + 1], set()).add(fields[3].decode())
    if not made:
        return []
    code, out = git_raw("ls-tree", "-r", "-z", base)
    if code != 0:
        fail(2, f"cannot read the tree of {base[:12]}. No request was sent.")
    at_base = {}
    for rec in out.split(b"\0"):
        meta, _, path = rec.partition(b"\t")
        if path in made:
            at_base[path] = meta.split()[2].decode()
    there, held = [], {}
    for path in sorted(made):
        full = os.path.join(os.fsencode(WORKSPACE), path)
        if os.path.islink(full) or b"\n" in path:
            continue
        if os.path.isfile(full):
            there.append(path)
        elif not os.path.lexists(full):
            held[path] = ABSENT
    if there:
        code, out = git_raw("hash-object", "--stdin-paths", stdin=b"\n".join(there) + b"\n")
        blobs = out.decode("ascii", "replace").split()
        if code != 0 or len(blobs) != len(there):
            fail(2, f"cannot read the files of {WORKSPACE} with git. No request was sent.")
        held.update(zip(there, blobs))
    return [p.decode("utf-8", "replace") for p in sorted(held)
            if held[p] in made[p] and held[p] != at_base.get(p, ABSENT)]


def workspace_base():
    """The origin/develop commit the workspace is built on, read from git.

    The supervisor measures the slice against it. A base that is newer than
    the files would make the slice undo develop commits; a base that is
    older would make it bring develop changes as its own. The base is an
    ancestor of HEAD, and `develop_in_files` refuses the second case. A
    history that says "merged" over files that were turned back on purpose
    (a reverted merge, reset --soft, merge -s ours) is not seen here."""
    code, _ = git("rev-parse", "--verify", "-q", "HEAD^{commit}")
    if code != 0:
        fail(2, f"{WORKSPACE} has no HEAD commit that git can read. No request was sent.")
    for name, what in (("MERGE_HEAD", "merge"), ("CHERRY_PICK_HEAD", "cherry-pick"),
                       ("REVERT_HEAD", "revert"), ("REBASE_HEAD", "rebase")):
        code, _ = git("rev-parse", "--verify", "-q", name)
        if code == 0:
            fail(2, f"a {what} in {WORKSPACE} is not finished. Finish it and commit it (or "
                    f"abort it), then submit again. No request was sent.")
    for name in ("rebase-merge", "rebase-apply"):
        # a rebase that stopped at `break`, `edit` or a failed `exec` has no REBASE_HEAD
        code, path = git("rev-parse", "--git-path", name)
        if code == 0 and os.path.exists(os.path.join(WORKSPACE, path)):
            fail(2, f"a rebase in {WORKSPACE} is not finished. Finish it (or abort it), then "
                    f"submit again. No request was sent.")
    code, _ = git("rev-parse", "--verify", "-q", DEVELOP_REF + "^{commit}")
    if code != 0:
        fail(2, f"{WORKSPACE} has no origin/develop (git fetch origin develop). "
                f"No request was sent.")
    code, base = git("merge-base", "HEAD", DEVELOP_REF)
    if code != 0 or not re.fullmatch(r"[0-9a-f]{40}", base):
        fail(2, f"HEAD of {WORKSPACE} has no common commit with origin/develop. "
                f"No request was sent.")
    paths = develop_in_files(base)
    if paths:
        more = f" and {len(paths) - 5} more" if len(paths) > 5 else ""
        fail(2, f"{WORKSPACE} holds changes of origin/develop that git has no merge of: "
                f"{', '.join(paths[:5])}{more}. In git, {WORKSPACE} is built on develop commit "
                f"{base[:12]}, and the slice is measured against that commit. Commit your "
                f"work, run `git merge origin/develop` (a real merge: not --squash, not "
                f"copied files), commit the merge, then submit again. No request was sent.")
    return base


def main(argv=None):
    ap = argparse.ArgumentParser(prog="slice-submit", add_help=True,
                                 description="Hand one slice of the epic to the supervisor.")
    ap.add_argument("--slice", type=int, required=True)
    ap.add_argument("--claim", required=True)
    ap.add_argument("--subject", required=True)
    ap.add_argument("--base", default="", help="not used: the base is read from git")
    ap.add_argument("--builds-on", type=int, default=0)
    ap.add_argument("--wait", type=int, default=DEFAULT_WAIT_SECS,
                    help="seconds to wait for the supervisor (default %(default)s)")
    args = ap.parse_args(argv)

    if not 1 <= args.slice <= 999:
        fail(2, "--slice must be a number from 1 to 999")
    if not 0 <= args.builds_on <= 999 or args.builds_on == args.slice:
        fail(2, "--builds-on must be the number of another slice")
    subject = args.subject.strip()
    if "\n" in subject or not re.fullmatch(r"[a-z0-9][a-z0-9/_.-]*: \S.*", subject):
        fail(2, '--subject must be one line of the form "<scope>: <what changed>"')
    if any(not 32 <= ord(c) < 127 for c in subject):
        fail(2, "--subject must be printable ASCII text")
    if len(subject) > SUBJECT_MAX_CHARS:
        fail(2, f"--subject is longer than {SUBJECT_MAX_CHARS} characters")
    try:
        with open(args.claim, "rb") as fh:
            claim = fh.read(CLAIM_CAP + 1)
    except OSError as exc:
        fail(2, f"--claim {args.claim}: {exc.strerror}")
    if len(claim) > CLAIM_CAP:
        fail(2, f"--claim is larger than {CLAIM_CAP} bytes")
    if not claim.strip():
        fail(2, "--claim is empty")

    base = workspace_base()
    if args.base and args.base != base:
        print(f"slice-submit: --base {args.base[:12]} is not used. /workspace is built on "
              f"origin/develop commit {base[:12]} (git merge-base HEAD origin/develop). To "
              f"build on a newer one, merge origin/develop and commit the merge.", flush=True)

    request_id = uuid.uuid4().hex
    submit_dir = os.path.join(OUT, "submit")
    try:
        os.makedirs(submit_dir, exist_ok=True)
    except OSError as exc:
        fail(3, f"cannot create {submit_dir}: {exc.strerror}")

    # Write under a dot name, then rename: the supervisor never sees half a request.
    tmp = os.path.join(submit_dir, f".{args.slice}-{request_id}.tmp")
    os.mkdir(tmp, 0o755)
    with open(os.path.join(tmp, "claim.md"), "wb") as fh:
        fh.write(claim)
    with open(os.path.join(tmp, "subject.txt"), "w", encoding="utf-8") as fh:
        fh.write(subject + "\n")
    with open(os.path.join(tmp, "request.json"), "w", encoding="utf-8") as fh:
        json.dump({"slice": args.slice, "request_id": request_id, "base": base,
                   "base_from": "git", "builds_on": args.builds_on}, fh)
    final = None
    for k in range(1, 10000):
        candidate = os.path.join(submit_dir, f"{args.slice}-{k}")
        try:
            os.rename(tmp, candidate)      # fails when the name is taken (a non-empty directory)
        except OSError:
            continue
        final = candidate
        break
    if final is None:
        fail(3, f"no free request name under {submit_dir}")

    print(f"slice-submit: request {os.path.basename(final)} written; "
          f"waiting for the supervisor to copy /workspace ...", flush=True)
    answer_file = os.path.join(CONTEXT, "slices", str(args.slice), "submitted.json")

    def answered():
        """0 or 1 when the supervisor answered this request, else None."""
        try:
            with open(answer_file, encoding="utf-8") as fh:
                answer = json.load(fh)
        except (OSError, ValueError):
            return None
        if not isinstance(answer, dict) or answer.get("request_id") != request_id:
            return None
        if answer.get("accepted"):
            print(f"slice-submit: slice {args.slice} round {answer.get('round')}: snapshot "
                  f"taken ({answer.get('files')} files). You may change /workspace again. "
                  f"The validator result comes later in {os.path.dirname(answer_file)}/.")
            return 0
        print(f"slice-submit: slice {args.slice}: REFUSED: {answer.get('reason')}",
              file=sys.stderr)
        return 1

    def remove(path):
        # handled requests must not pile up: the supervisor reads at most 512 entries
        shutil.rmtree(path, ignore_errors=True)

    deadline = time.monotonic() + max(1, args.wait)
    while time.monotonic() < deadline:
        code = answered()
        if code is not None:
            remove(final)
            return code
        time.sleep(1)
    # Withdraw the request: a supervisor that comes back later must not take a
    # snapshot of a workspace that has moved on.
    withdrawn = os.path.join(submit_dir, f".{os.path.basename(final)}-{request_id}.withdrawn")
    try:
        os.rename(final, withdrawn)
        state = "The request was withdrawn"
    except OSError:
        withdrawn = None
        state = f"The request could not be withdrawn and stays in {final}"
    # The supervisor may have read the request a moment before the rename and
    # be at work on the snapshot. It checks for the directory again when the
    # snapshot is done; give its answer a short time to come.
    for _ in range(WITHDRAW_GRACE_SECS):
        code = answered()
        if code is not None:
            break
        time.sleep(1)
    if withdrawn:
        remove(withdrawn)
    if code is not None:
        return code
    fail(3, f"no answer from the supervisor after {args.wait} seconds. {state}. Read "
            f"{os.path.dirname(answer_file)}/status.json before you submit this slice again.")


if __name__ == "__main__":
    sys.exit(main())
