#!/usr/bin/env python3
"""Fake trufflehog: reports a finding for any file containing FAKE-GENERIC-SECRET."""
import json, os, sys
root = sys.argv[2]
for d, _, files in os.walk(root):
    for f in files:
        p = os.path.join(d, f)
        if "FAKE-GENERIC-SECRET" in open(p, errors="replace").read():
            print(json.dumps({"DetectorName": "FakeGeneric", "SourceMetadata": {"Data": {"Filesystem": {"file": p, "line": 1}}}}))
